#!/usr/bin/env python3
"""
omarchy-session: macOS-style session save & restore for Omarchy (Hyprland + Wayland).

Saves active windows, workspaces, working directories, and browser states before shutdown,
and offers an interactive prompt at boot to reopen everything seamlessly.
"""

import sys
import os
import json
import time
import subprocess
import argparse
import shutil
import threading
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "omarchy" / "session"
SESSION_FILE = CONFIG_DIR / "last-session.json"
BACKUP_FILE = CONFIG_DIR / "last-session.json.bak"
CONFIG_FILE = CONFIG_DIR / "config.json"

DEFAULT_CONFIG = {
    "enabled": True,
    "auto_restore": False,
    "clean_delay_sec": 10,
    "ignored_classes": [
        "quickshell",
        "org.quickshell",
        "hyprland-share-picker",
        "omarchy-osd",
        "xwaylandvideobridge",
        "looking-glass-client",
        "rofi",
        "walker",
        "tofi",
        "wofi",
        "zenity",
        "yad"
    ]
}

def load_config():
    if not CONFIG_DIR.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
            merged = DEFAULT_CONFIG.copy()
            merged.update(cfg)
            return merged
    except Exception as e:
        print(f"[omarchy-session] Warning: Failed to read config: {e}", file=sys.stderr)
        return DEFAULT_CONFIG.copy()

def save_config(cfg):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print(f"[omarchy-session] Error saving config: {e}", file=sys.stderr)

def run_cmd(cmd, check=False):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=check)
        return res.stdout.strip()
    except Exception as e:
        if check:
            raise
        return ""

def hyprctl_eval(lua_code):
    try:
        subprocess.run(["hyprctl", "eval", lua_code], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
    except Exception as e:
        print(f"[omarchy-session] hyprctl eval failed for: {lua_code}\nError: {e}", file=sys.stderr)

def get_process_cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
        return [a.decode("utf-8", errors="replace") for a in raw.split(b"\x00") if a]
    except Exception:
        return []

def get_process_cwd(pid):
    try:
        cwd = os.path.realpath(f"/proc/{pid}/cwd")
        if os.path.isdir(cwd):
            return cwd
    except Exception:
        pass
    return str(Path.home())

def get_terminal_cwd_and_cmd(pid):
    best_cwd = str(Path.home())
    is_herdr = False
    
    try:
        children_out = run_cmd(["pgrep", "-P", str(pid)])
        child_pids = [int(p) for p in children_out.split() if p.isdigit()]
        for cpid in child_pids:
            cmdline = get_process_cmdline(cpid)
            cmd_str = " ".join(cmdline).lower()
            if "herdr" in cmd_str:
                is_herdr = True
            
            grand_out = run_cmd(["pgrep", "-P", str(cpid)])
            for gpid in [int(p) for p in grand_out.split() if p.isdigit()]:
                g_cmdline = get_process_cmdline(gpid)
                if "herdr" in " ".join(g_cmdline).lower():
                    is_herdr = True
            
            c_cwd = get_process_cwd(cpid)
            if c_cwd and c_cwd != "/":
                best_cwd = c_cwd
    except Exception:
        pass

    if best_cwd == str(Path.home()):
        proc_cwd = get_process_cwd(pid)
        if proc_cwd and proc_cwd != "/":
            best_cwd = proc_cwd

    return best_cwd, is_herdr

def report_herdr_agent_session(pane_id, agent, session_id):
    sock_path = Path.home() / ".config" / "herdr" / "herdr.sock"
    if not sock_path.exists():
        return False
    try:
        import socket
        seq = time.time_ns()
        req = {
            "id": f"omarchy-session:{seq}",
            "method": "pane.report_agent_session",
            "params": {
                "pane_id": pane_id,
                "source": f"herdr:{agent}",
                "agent": agent,
                "seq": seq,
                "agent_session_id": session_id
            }
        }
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1.0)
            s.connect(str(sock_path))
            s.sendall((json.dumps(req) + "\n").encode())
            s.recv(4096)
            return True
    except Exception:
        return False

def save_session():
    cfg = load_config()
    if not cfg.get("enabled", True):
        print("[omarchy-session] Feature is disabled in config.", file=sys.stderr)
        return False

    try:
        clients_json = run_cmd(["hyprctl", "clients", "-j"], check=True)
        clients = json.loads(clients_json)
    except Exception as e:
        print(f"[omarchy-session] Failed to query hyprctl clients: {e}", file=sys.stderr)
        return False

    ignored = set(cfg.get("ignored_classes", []))
    saved_windows = []
    has_chromium = False
    chromium_bin = shutil.which("chromium") or shutil.which("google-chrome-stable") or "/usr/bin/chromium"

    for c in clients:
        ws = c.get("workspace", {})
        ws_id = ws.get("id", -1)
        if ws_id < 1:
            continue

        w_class = c.get("class", "").strip()
        title = c.get("title", "").strip()
        pid = c.get("pid", 0)

        if not w_class or w_class in ignored:
            continue

        exe = ""
        if pid and os.path.exists(f"/proc/{pid}/exe"):
            try:
                exe = os.path.realpath(f"/proc/{pid}/exe")
            except Exception:
                exe = ""

        app_type = "generic"
        meta = {}

        w_class_lower = w_class.lower()
        if (
            "chromium" in w_class_lower
            or "google-chrome" in w_class_lower
            or "brave" in w_class_lower
            or w_class.startswith("chrome-")
        ):
            app_type = "chromium"
            has_chromium = True
            is_pwa = w_class.startswith("chrome-")
            meta = {
                "is_pwa": is_pwa,
                "pwa_class": w_class if is_pwa else None
            }

        elif (
            w_class_lower in ["foot", "alacritty", "kitty", "ghostty", "com.mitchellh.ghostty"]
            or "term_restore" in w_class_lower
            or any(t in w_class_lower for t in ["foot", "alacritty", "kitty", "ghostty"])
            or (exe and any(t in Path(exe).name.lower() for t in ["foot", "alacritty", "kitty", "ghostty"]))
        ):
            app_type = "terminal"
            cwd, is_herdr = get_terminal_cwd_and_cmd(pid)
            if not is_herdr and ("herdr" in title.lower() or title.lower().startswith("omarchy:")):
                is_herdr = True

            real_term_class = "foot"
            for t in ["alacritty", "kitty", "ghostty", "foot"]:
                if t in w_class_lower or (exe and t in Path(exe).name.lower()):
                    real_term_class = t
                    break

            meta = {
                "terminal_class": real_term_class,
                "cwd": cwd,
                "is_herdr": is_herdr
            }

        elif w_class_lower in ["code", "vscodium", "cursor"]:
            app_type = "vscode"
            cmdline = get_process_cmdline(pid)
            opened_dir = None
            for arg in cmdline[1:]:
                if os.path.isdir(arg):
                    opened_dir = os.path.abspath(arg)
                    break
            meta = {
                "opened_dir": opened_dir,
                "cmdline": cmdline
            }

        else:
            meta = {
                "exe": exe,
                "cmdline": get_process_cmdline(pid)
            }

        saved_windows.append({
            "workspace_id": ws_id,
            "workspace_name": ws.get("name", str(ws_id)),
            "class": w_class,
            "initial_class": c.get("initialClass", w_class),
            "title": title,
            "pid": pid,
            "app_type": app_type,
            "meta": meta,
            "monitor": c.get("monitor", 0),
            "floating": c.get("floating", False)
        })

    # Capture active Herdr agents and sessions if herdr is installed
    herdr_agents = []
    if shutil.which("herdr"):
        try:
            snap_raw = run_cmd(["herdr", "api", "snapshot"])
            if snap_raw:
                snap_data = json.loads(snap_raw).get("result", {}).get("snapshot", {})
                agents_list = snap_data.get("agents", [])
                
                # Check presence locks for any agy processes
                presence_dir = Path.home() / ".gemini" / "antigravity-cli" / "presence"
                pid_to_cid = {}
                if presence_dir.exists():
                    try:
                        lsof_out = run_cmd(["lsof", f"{presence_dir}/*.lock"], check=False)
                        for line in lsof_out.splitlines():
                            parts = line.split()
                            if len(parts) >= 9 and parts[1].isdigit() and parts[8].endswith(".lock"):
                                pid_to_cid[int(parts[1])] = Path(parts[8]).stem
                    except Exception:
                        pass

                for a in agents_list:
                    p_id = a.get("pane_id")
                    agent_name = a.get("agent")
                    session_obj = a.get("agent_session")
                    session_id = None
                    if isinstance(session_obj, dict):
                        session_id = session_obj.get("value")

                    # If agy session_id not registered yet, resolve from presence and report to Herdr
                    if not session_id and agent_name == "agy" and pid_to_cid:
                        for agy_pid, cid in pid_to_cid.items():
                            try:
                                ppid = int(run_cmd(["ps", "-o", "ppid=", "-p", str(agy_pid)]).strip())
                                gppid = int(run_cmd(["ps", "-o", "ppid=", "-p", str(ppid)]).strip())
                                gcmd = run_cmd(["ps", "-o", "comm=", "-p", str(gppid)]).strip()
                                if "herdr" in gcmd:
                                    session_id = cid
                                    report_herdr_agent_session(p_id, "agy", cid)
                                    break
                            except Exception:
                                pass

                    herdr_agents.append({
                        "agent": agent_name,
                        "pane_id": p_id,
                        "cwd": a.get("cwd", str(Path.home())),
                        "tab_id": a.get("tab_id"),
                        "workspace_id": a.get("workspace_id"),
                        "session_id": session_id
                    })
        except Exception:
            # Fallback to simple agent list
            try:
                agent_raw = run_cmd(["herdr", "agent", "list"])
                if agent_raw:
                    data = json.loads(agent_raw)
                    for a in data.get("result", {}).get("agents", []):
                        herdr_agents.append({
                            "agent": a.get("agent"),
                            "pane_id": a.get("pane_id"),
                            "cwd": a.get("cwd", str(Path.home())),
                            "tab_id": a.get("tab_id"),
                            "workspace_id": a.get("workspace_id"),
                            "session_id": None
                        })
            except Exception:
                pass

    session_data = {
        "timestamp": time.time(),
        "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "has_chromium": has_chromium,
        "chromium_bin": chromium_bin,
        "window_count": len(saved_windows),
        "windows": saved_windows,
        "herdr_agents": herdr_agents
    }

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(SESSION_FILE, "w", encoding="utf-8") as f:
        json.dump(session_data, f, indent=2)

    distinct_ws = len(set(w["workspace_id"] for w in saved_windows))
    print(f"[omarchy-session] Saved {len(saved_windows)} window(s) across {distinct_ws} workspace(s), {len(herdr_agents)} Herdr agent(s).")
    return True

def reconcile_windows(expected_windows, max_duration=10.0, poll_interval=0.3):
    """
    Active reconciliation: monitors hyprctl clients as apps launch and immediately moves
    any window that landed on the wrong workspace to its intended workspace.
    """
    start_time = time.time()
    targets = []
    for w in expected_windows:
        targets.append({
            "target_ws": w["workspace_id"],
            "class": w.get("class", "").lower(),
            "initial_class": w.get("initial_class", "").lower(),
            "custom_app_id": w.get("custom_app_id", "").lower(),
            "title": w.get("title", "").lower(),
            "app_type": w.get("app_type", "generic"),
            "is_herdr": w.get("meta", {}).get("is_herdr", False)
        })

    moved_addresses = set()

    while time.time() - start_time < max_duration:
        try:
            raw = run_cmd(["hyprctl", "clients", "-j"])
            if not raw:
                time.sleep(poll_interval)
                continue
            current_clients = json.loads(raw)
        except Exception:
            time.sleep(poll_interval)
            continue

        for c in current_clients:
            addr = c.get("address")
            if not addr or addr in moved_addresses:
                continue

            current_ws = c.get("workspace", {}).get("id")
            c_class = c.get("class", "").lower()
            c_init_class = c.get("initialClass", "").lower()
            c_title = c.get("title", "").lower()

            for t in targets:
                target_ws = t["target_ws"]
                matched = False

                if t.get("custom_app_id") and (t["custom_app_id"] in c_class or t["custom_app_id"] in c_init_class):
                    matched = True
                elif t.get("is_herdr") and ("herdr" in c_title or c_title.startswith("omarchy:")):
                    matched = True
                elif t["class"] and (t["class"] == c_class or t["class"] == c_init_class):
                    matched = True
                elif t["app_type"] == "chromium" and t["title"] and len(t["title"]) > 3:
                    # Match key titles like Gmail, BBC, etc.
                    key_part = t["title"][:20]
                    if key_part in c_title:
                        matched = True

                if matched:
                    if current_ws != target_ws:
                        run_cmd(["hyprctl", "dispatch", "movetoworkspacesilent", f"{target_ws},address:{addr}"])
                        print(f"[omarchy-session] Reconciled {c.get('class')} ({c.get('title')[:25]}) -> Workspace {target_ws}")
                    moved_addresses.add(addr)
                    break

        time.sleep(poll_interval)

def restore_session():
    if not SESSION_FILE.exists():
        print("[omarchy-session] No saved session file found.")
        return False

    try:
        with open(SESSION_FILE, "r", encoding="utf-8") as f:
            session = json.load(f)
    except Exception as e:
        print(f"[omarchy-session] Error reading session file: {e}", file=sys.stderr)
        return False

    windows = session.get("windows", [])
    if not windows:
        print("[omarchy-session] Saved session is empty.")
        clear_session()
        return False

    cfg = load_config()
    print(f"[omarchy-session] Restoring {len(windows)} application(s)...")

    chromium_windows = [w for w in windows if w["app_type"] == "chromium"]
    terminal_windows = [w for w in windows if w["app_type"] == "terminal"]
    vscode_windows = [w for w in windows if w["app_type"] == "vscode"]
    generic_windows = [w for w in windows if w["app_type"] == "generic"]

    # Initial Hyprland window rules
    for cw in chromium_windows:
        ws_id = cw["workspace_id"]
        c_class = cw["class"]
        hyprctl_eval(f'o.window("{c_class}", {{ workspace = "{ws_id} silent" }})')

    launched_execs = set()
    for gw in generic_windows:
        ws_id = gw["workspace_id"]
        c_class = gw["class"]
        hyprctl_eval(f'o.window("{c_class}", {{ workspace = "{ws_id} silent" }})')

    # Launch Chromium
    if session.get("has_chromium", False):
        chrom_bin = shutil.which("chromium") or shutil.which("google-chrome-stable") or session.get("chromium_bin") or "chromium"
        print(f"[omarchy-session] Launching {chrom_bin} with --restore-last-session...")
        subprocess.Popen(
            [chrom_bin, "--restore-last-session"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )

    # Launch Terminals
    term_idx = 0
    for tw in terminal_windows:
        term_idx += 1
        ws_id = tw["workspace_id"]
        meta = tw.get("meta", {})
        cwd = meta.get("cwd", str(Path.home()))
        is_herdr = meta.get("is_herdr", False)
        term_class = meta.get("terminal_class", "foot")

        custom_app_id = f"term_restore_{ws_id}_{term_idx}"
        tw["custom_app_id"] = custom_app_id
        hyprctl_eval(f'o.window("^{custom_app_id}$", {{ workspace = "{ws_id} silent" }})')

        launch_args = []
        if "foot" in term_class:
            launch_args = ["foot", f"--app-id={custom_app_id}", f"--working-directory={cwd}"]
            if is_herdr:
                launch_args.append("herdr")
        elif "alacritty" in term_class:
            launch_args = ["alacritty", "--class", custom_app_id, "--working-directory", cwd]
            if is_herdr:
                launch_args.extend(["-e", "herdr"])
        elif "ghostty" in term_class:
            launch_args = ["ghostty", f"--class={custom_app_id}", f"--working-directory={cwd}"]
            if is_herdr:
                launch_args.extend(["-e", "herdr"])
        elif "kitty" in term_class:
            launch_args = ["kitty", "--class", custom_app_id, "--directory", cwd]
            if is_herdr:
                launch_args.extend(["herdr"])
        else:
            launch_args = ["foot", f"--app-id={custom_app_id}", f"--working-directory={cwd}"]
            if is_herdr:
                launch_args.append("herdr")

        subprocess.Popen(
            launch_args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        time.sleep(0.15)

    # Launch VS Code
    for vw in vscode_windows:
        ws_id = vw["workspace_id"]
        meta = vw.get("meta", {})
        opened_dir = meta.get("opened_dir")
        hyprctl_eval(f'o.window("^[cC]ode$", {{ workspace = "{ws_id} silent" }})')
        args = ["code"]
        if opened_dir:
            args.append(opened_dir)
        subprocess.Popen(
            args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )

    # Launch Generic Apps (Telegram, etc.)
    for gw in generic_windows:
        meta = gw.get("meta", {})
        exe = meta.get("exe")
        if exe and os.path.exists(exe) and exe not in launched_execs:
            launched_execs.add(exe)
            subprocess.Popen(
                [exe],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )
            time.sleep(0.1)

    # Active Reconciliation Loop: ensures every window lands on its correct workspace
    print("[omarchy-session] Reconciling window positions across workspaces...")
    reconcile_windows(windows, max_duration=10.0, poll_interval=0.3)

    # Relaunch / reconcile Herdr agents if saved
    saved_herdr_agents = session.get("herdr_agents", [])
    if saved_herdr_agents and shutil.which("herdr"):
        def resume_herdr_agents():
            sock_path = Path.home() / ".config" / "herdr" / "herdr.sock"
            server_ready = False
            for _ in range(30):
                if sock_path.exists():
                    try:
                        st = run_cmd(["herdr", "status", "server", "--json"], check=False)
                        if st and json.loads(st).get("running") is True:
                            server_ready = True
                            break
                    except Exception:
                        pass
                time.sleep(0.5)

            if not server_ready:
                print("[omarchy-session] Herdr server socket not ready after timeout; skipping agent fallback.")
                return

            # Give Herdr's native agent restore a moment to initialize restored panes
            time.sleep(2.5)

            active_agents = {}
            try:
                snap = run_cmd(["herdr", "api", "snapshot"], check=False)
                if snap:
                    s_data = json.loads(snap).get("result", {}).get("snapshot", {})
                    for a in s_data.get("agents", []):
                        active_agents[a.get("pane_id")] = a
            except Exception:
                pass

            for ha in saved_herdr_agents:
                p_id = ha.get("pane_id")
                agent_name = ha.get("agent")
                session_id = ha.get("session_id")
                if not p_id or not agent_name:
                    continue

                # Check if Herdr already resumed this pane natively
                current = active_agents.get(p_id)
                if current and current.get("agent") == agent_name and current.get("agent_status") in ("working", "idle", "blocked"):
                    print(f"[omarchy-session] Herdr native restore active for {agent_name} in {p_id}.")
                    continue

                # Fallback: if native restore did not resume the agent, launch it with conversation ID
                resume_cmd = agent_name
                if agent_name == "agy" and session_id:
                    resume_cmd = f"agy --conversation {session_id}"
                elif agent_name == "claude" and session_id:
                    resume_cmd = f"claude --resume {session_id}"
                elif agent_name == "codex" and session_id:
                    resume_cmd = f"codex resume {session_id}"
                elif agent_name == "pi" and session_id:
                    resume_cmd = f"pi --session {session_id}"

                print(f"[omarchy-session] Fallback resuming agent in Herdr pane {p_id}: {resume_cmd}")
                run_cmd(["herdr", "pane", "run", p_id, resume_cmd], check=False)

        threading.Thread(target=resume_herdr_agents, daemon=True).start()

    # Reset dynamic rules
    hyprctl_eval("hl.reload()")

    try:
        SESSION_FILE.replace(BACKUP_FILE)
    except Exception:
        pass

    distinct_ws = len(set(w["workspace_id"] for w in windows))
    agent_msg = f", {len(saved_herdr_agents)} agent(s)" if saved_herdr_agents else ""
    run_cmd([
        "notify-send",
        "-a", "Omarchy Session",
        "-i", "document-revert",
        "Session Restored",
        f"Reopened {len(windows)} app(s){agent_msg} across {distinct_ws} workspace(s)."
    ])
    return True

def prompt_user():
    if not SESSION_FILE.exists():
        return

    cfg = load_config()
    if not cfg.get("enabled", True):
        return

    if cfg.get("auto_restore", False):
        print("[omarchy-session] Auto-restore is enabled. Restoring without prompt...")
        restore_session()
        return

    try:
        with open(SESSION_FILE, "r", encoding="utf-8") as f:
            session = json.load(f)
    except Exception:
        return

    win_count = session.get("window_count", 0)
    windows = session.get("windows", [])
    distinct_ws = len(set(w["workspace_id"] for w in windows))
    herdr_count = len(session.get("herdr_agents", []))
    subtext_extra = f", {herdr_count} agent(s)" if herdr_count > 0 else ""

    prompt_text = "Restore Previous Session?"
    opt_restore = f"✨\tReopen Windows & Workspaces\tRestore {win_count} apps{subtext_extra} across {distinct_ws} workspaces"
    opt_fresh = "❌\tStart Fresh\tDiscard saved session"
    opt_always = "⚙️\tAlways Reopen at Boot\tRestore automatically on startup"
    opt_disable = "🚫\tDisable Session Restore\tTurn off session saving"

    try:
        res = subprocess.run(
            ["omarchy", "menu", "select", prompt_text, opt_restore, opt_fresh, opt_always, opt_disable, "--", "--width", "520"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        choice = res.stdout.strip()
    except Exception as e:
        print(f"[omarchy-session] Error opening menu: {e}", file=sys.stderr)
        return

    if not choice:
        print("[omarchy-session] Prompt dismissed.")
        return

    if "Reopen Windows & Workspaces" in choice:
        restore_session()
    elif "Start Fresh" in choice:
        clear_session()
        run_cmd(["notify-send", "-a", "Omarchy Session", "Fresh Session", "Previous session discarded."])
    elif "Always Reopen" in choice:
        cfg["auto_restore"] = True
        save_config(cfg)
        run_cmd(["notify-send", "-a", "Omarchy Session", "Auto-Restore Enabled", "Future sessions will reopen automatically."])
        restore_session()
    elif "Disable Session Restore" in choice:
        cfg["enabled"] = False
        save_config(cfg)
        clear_session()
        run_cmd(["notify-send", "-a", "Omarchy Session", "Disabled", "Session restore has been disabled."])

def clear_session():
    if SESSION_FILE.exists():
        try:
            SESSION_FILE.unlink()
            print("[omarchy-session] Cleared saved session.")
        except Exception as e:
            print(f"[omarchy-session] Error removing session file: {e}", file=sys.stderr)

def status_session():
    cfg = load_config()
    print("=== Omarchy Session Restore Status ===")
    print(f"Enabled: {cfg.get('enabled')}")
    print(f"Auto-Restore at Boot: {cfg.get('auto_restore')}")
    print(f"Session File: {SESSION_FILE}")
    if SESSION_FILE.exists():
        try:
            with open(SESSION_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            print(f"Saved At: {data.get('created_at')}")
            print(f"Window Count: {data.get('window_count')}")
            agents = data.get("herdr_agents", [])
            if agents:
                print(f"Herdr Agents: {len(agents)}")
                for a in agents:
                    s_id = a.get("session_id")
                    s_info = f", session: {s_id[:8]}..." if s_id else ""
                    print(f"  🤖 Agent: {a.get('agent')} (pane: {a.get('pane_id')}{s_info})")
            windows = data.get("windows", [])
            for w in windows:
                print(f"  • [WS {w['workspace_id']}] {w['class']} ({w['app_type']}) - {w['title'][:40]}")
        except Exception as e:
            print(f"Error reading session: {e}")
    else:
        print("No active saved session on disk.")

def main():
    parser = argparse.ArgumentParser(description="Omarchy Session Restore CLI")
    parser.add_argument("action", choices=["save", "restore", "prompt", "clear", "status"], help="Action to perform")
    args = parser.parse_args()

    if args.action == "save":
        save_session()
    elif args.action == "restore":
        restore_session()
    elif args.action == "prompt":
        prompt_user()
    elif args.action == "clear":
        clear_session()
    elif args.action == "status":
        status_session()

if __name__ == "__main__":
    main()
