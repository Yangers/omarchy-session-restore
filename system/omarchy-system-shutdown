#!/bin/bash
# Omarchy shutdown wrapper: saves session state before closing apps and powering off

if command -v omarchy-session >/dev/null 2>&1; then
    omarchy-session save
elif [[ -x "$HOME/.local/bin/omarchy-session" ]]; then
    "$HOME/.local/bin/omarchy-session" save
fi

exec /usr/share/omarchy/bin/omarchy-system-shutdown "$@"
